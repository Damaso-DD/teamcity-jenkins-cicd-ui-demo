/**
 * Jenkins Pipeline Configuration - FAILING VERSION
 * 
 * This is a pre-configured version that will demonstrate test failures.
 * Use this to easily show how Jenkins displays failing tests and errors.
 * 
 * To use this version:
 * 1. Rename this file to 'Jenkinsfile' (backup the original first)
 * 2. Or configure Jenkins to use this file specifically
 * 
 * This version sets ENABLE_FAILING_TESTS=true by default.
 */

pipeline {
    agent any
    
    environment {
        VENV_PATH = "${WORKSPACE}/venv"
        
        // This version ALWAYS enables failing tests
        ENABLE_FAILING_TESTS = "true"
        
        ARTIFACT_DIR = "${WORKSPACE}/artifacts"
        BUILD_TIMESTAMP = sh(script: "date +%Y%m%d_%H%M%S", returnStdout: true).trim()
    }
    
    stages {
        stage('Build') {
            steps {
                echo '========================================='
                echo 'STAGE: Build (Failing Pipeline Demo)'
                echo '========================================='
                echo "⚠️  This pipeline is configured to FAIL for demonstration"
                echo "Building on branch: ${env.BRANCH_NAME ?: 'main'}"
                
                sh 'python3 --version'
                
                echo 'Creating Python virtual environment...'
                sh '''
                    python3 -m venv ${VENV_PATH}
                    . ${VENV_PATH}/bin/activate
                    pip install --upgrade pip
                '''
                
                echo 'Installing dependencies...'
                sh '''
                    . ${VENV_PATH}/bin/activate
                    pip install -r requirements.txt
                    pip list
                '''
                
                echo 'Running code quality checks with flake8...'
                sh '''
                    . ${VENV_PATH}/bin/activate
                    flake8 src/ tests/ --statistics || true
                '''
                
                echo 'Build stage completed successfully!'
            }
        }
        
        stage('Test') {
            steps {
                echo '========================================='
                echo 'STAGE: Test (Will Fail)'
                echo '========================================='
                echo "⚠️  Test failure mode: ${ENABLE_FAILING_TESTS}"
                echo "Tests are configured to fail for demonstration purposes"
                
                echo 'Running unit tests...'
                sh '''
                    . ${VENV_PATH}/bin/activate
                    pytest tests/ --junitxml=test-results.xml || true
                '''
                
                echo 'Test stage completed (with failures)!'
            }
            
            post {
                always {
                    junit 'test-results.xml'
                    
                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'htmlcov',
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report'
                    ])
                }
            }
        }
        
        stage('Deploy') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                    expression { env.BRANCH_NAME?.startsWith('feature/') }
                }
            }
            
            steps {
                echo '========================================='
                echo 'STAGE: Deploy'
                echo '========================================='
                echo "Note: Deploy stage runs even with test failures (for demo)"
                
                sh 'mkdir -p ${ARTIFACT_DIR}'
                
                echo 'Generating deployment artifacts...'
                sh '''
                    . ${VENV_PATH}/bin/activate
                    python scripts/deploy.py
                '''
                
                echo 'Deploy stage completed!'
            }
            
            post {
                success {
                    archiveArtifacts artifacts: 'artifacts/**/*', 
                                   fingerprint: true,
                                   allowEmptyArchive: false
                }
            }
        }
    }
    
    post {
        always {
            echo '========================================='
            echo 'Pipeline Execution Complete (Failing Demo)'
            echo '========================================='
            echo "Final Status: ${currentBuild.result ?: 'SUCCESS'}"
        }
        
        unstable {
            echo '⚠ Pipeline is unstable due to test failures!'
            echo 'This is expected for the failing demo version.'
        }
    }
}
